      ],
      "cardId": "beriev_be4",
      "description": "别里耶夫 Be-4 最初称为 KOR-2，是二战苏联用于海上侦察和轰炸的飞行艇。它采用双翼及中央浮筒设计，搭载 3 名乘员，可在陆地和水面起降。共生产 47 架，主要在黑海、波罗的海和北冰洋地区服役。"
    },
    {
      "id": "wallpaper-usa-t_loading_usa_05",
      "name": "美国：大规模部署",
      "file": "/assets/tablecloths/wallpaper/USA/usa_mass_deployment.png",
      "type": "wallpaper",
      "nation": "USA",
      "previousFiles": [
