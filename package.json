{
  "name": "kards-toolbox",
  "private": true,
  "version": "1.3.7",
  "license": "MIT",
  "description": "KARDS Toolbox — local-first card library and deck manager for Windows.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "tsx server.ts",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/build-wails.cjs dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build && node scripts/collect-licenses.cjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:express",
    "build:desktop": "node scripts/build-wails.cjs build",
    "build:desktop:dev": "node scripts/build-wails.cjs build --developer",
    "dist:win": "npm run dist:win:dir",
    "dist:win:dir": "node scripts/build-wails.cjs dir",
    "dist:win:zip": "node scripts/build-wails.cjs zip",
    "dist:win:portable": "node scripts/build-wails.cjs portable",
    "dist:win:dir:full": "node scripts/build-wails.cjs full-dir",
    "dist:win:portable:full": "node scripts/build-wails.cjs full-portable",
    "build:cache-bundle": "node scripts/build-wails.cjs cache-only",
    "build:packs": "tsx scripts/build-packs.ts",
    "export:cache:loose": "node scripts/export-cache.cjs --to-loose",
    "export:cache:pack": "node scripts/export-cache.cjs --to-pack",
    "dist:win:portable:dev": "node scripts/build-wails.cjs portable --developer",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean-build.cjs",
    "lint": "tsc --noEmit",
    "test:deck-import": "tsx src/lib/deckImport.test.ts",
    "test:deck-image-header": "tsx src/lib/deckRenderHeader.test.ts",
    "test": "npm run test:deck-import && tsx src/lib/deckCode.test.ts && tsx src/lib/deckCostCurve.test.ts && tsx src/lib/deckAnalysis.test.ts && tsx src/lib/deckImageImport.test.ts && npm run test:deck-image-header && tsx src/lib/appDialogs.test.ts && tsx src/lib/backup.test.ts && tsx src/lib/userDataStorage.test.ts && tsx tooling/cacheBundle.test.ts && tsx src/lib/cardData.test.ts && tsx src/lib/cardAssets.test.ts && tsx src/lib/cardFilters.test.ts && tsx src/lib/cardKeywords.test.tsx && tsx src/lib/pagination.test.ts && tsx src/lib/cardImages.test.ts && tsx src/lib/cardPacks.test.ts && tsx src/lib/packHistory.test.ts",
    "test:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-wails.ps1",
    "app": "start \"\" \"release/win-unpacked/kards_toolbox.exe\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "jsqr": "^1.4.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
